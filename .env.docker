ENV=dev
SETUP_TYPE=all
DEPLOYMENT_NAME=clinic-booking
SYSTEM_HOST=0.0.0.0
SYSTEM_PORT=8080

# MySQL
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USERNAME=clinic
DATABASE_PASSWORD=clinic
DATABASE_NAME=clinic
DATABASE_IDLE_CONNECTION=10
DATABASE_MAX_CONNECTION=50
DATABASE_CONNECTION_LIFETIME=300

#Redis 
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE_NUMBER=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=clinic

#Clinic domain 
# appointments are stored in UTC.
CLINIC_TIMEZONE=Africa/Nairobi #application logic for lookups. The app needs to know the time recorded in the DB plainly as 8:00:00, whose 8AM is that? Timezone answers that and tells the app Nairobi, so 8:00:00 belongs to nairobi
SLOT_DURATION_MINUTES=30
BOOKING_MINIMUM_LEAD_MINUTES=60
AVAILABILITY_CACHE_TTL_SECONDS=60
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# HTTP middleware 
CORS_ALLOWED_ORIGINS=*
API_TIMEOUT_IN_SECONDS=30
RATE_LIMIT_RATE=20
RATE_LIMIT_BURST=5
RATE_LIMIT_INTERVAL=5

# Observability 
UPTRACE_DSN=
